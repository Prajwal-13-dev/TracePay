# Copy to .env and fill in. .env is git-ignored: never commit it.

# Database owner (runs migrations, seeds and tests through docker compose exec)
PG_OWNER_PASSWORD=change-me
OWNER_DATABASE_URL=postgres://tracepay_owner:change-me@localhost:5433/tracepay

# The web app's own limited role (created by 014_db_roles.sql; npm run db:reset sets this password)
PG_APP_PASSWORD=change-me-app
DATABASE_URL=postgres://tracepay_app:change-me-app@localhost:5433/tracepay

# 32+ random characters. PowerShell: [Convert]::ToBase64String((1..32 | % { Get-Random -Max 256 }))
AUTH_SECRET=replace-with-32-plus-random-characters

# Neo4j (transfer graph for tracing). Password: 8+ characters, letters and digits.
NEO4J_PASSWORD=change-me-neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j

# Opening balance (₹) for the account every new customer gets at sign-up. 0 for a real deployment.
DEMO_OPENING_BALANCE=100000
