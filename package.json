{
  "name": "tracepay",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "embed": "node --env-file=.env scripts/embed.mjs",
    "graph:sync": "node --env-file=.env scripts/graph-sync.mjs",
    "graph:once": "node --env-file=.env scripts/graph-sync.mjs --once",
    "graph:rebuild": "node --env-file=.env scripts/graph-sync.mjs --rebuild",
    "db:reset": "node --env-file-if-exists=.env scripts/reset-db.mjs",
    "test:e2e": "playwright test",
    "test:db": "node --env-file-if-exists=.env scripts/run-db-tests.mjs",
    "graph:test": "node --env-file-if-exists=.env scripts/graph-test.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.2",
    "bcryptjs": "^3.0.3",
    "cytoscape": "^3.34.4",
    "jose": "^6.2.15",
    "neo4j-driver": "^6.3.0",
    "next": "16.4.5",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "typescript": "^5"
  }
